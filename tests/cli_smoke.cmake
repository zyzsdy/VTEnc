function(check_cli expected_status expected_output expected_error)
    execute_process(COMMAND "${VTENC}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${ARGN}: expected ${expected_status}, got ${status}: ${error}")
    endif()
    if(NOT output MATCHES "${expected_output}" OR NOT error MATCHES "${expected_error}")
        message(FATAL_ERROR "${ARGN}: unexpected stdout=[${output}], stderr=[${error}]")
    endif()
endfunction()

check_cli(0 "Usage:" "^$")
check_cli(0 "VTEnc [0-9]+\\.[0-9]+\\.[0-9]+" "^$" --version)
check_cli(0 "File transcoding is not implemented yet" "^$" --help)
check_cli(2 "^$" "Unknown argument" --bogus)
check_cli(2 "^$" "Missing value" --check-features --codec)
check_cli(2 "^$" "Supported probe codecs" --check-features --codec av1)
check_cli(2 "^$" "H.264 probe supports only 8-bit" --check-features --output-depth 10)
check_cli(2 "^$" "require --check-features" --codec hevc)
check_cli(2 "^$" "exactly one command" --help --check-features)
check_cli(2 "^$" "Duplicate option" --check-features --codec hevc --codec h264)
check_cli(2 "^$" "must be 8 or 10" --check-features --output-depth 12)
