execute_process(COMMAND "${VTENC}" --version --json-status
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(JSON event GET "${err}" event)
string(JSON schema GET "${err}" schema_version)
if(NOT result EQUAL 0 OR NOT out STREQUAL "" OR NOT event STREQUAL "version" OR NOT schema EQUAL 1)
    message(FATAL_ERROR "Invalid JSON version protocol: ${out} ${err}")
endif()
execute_process(COMMAND "${VTENC}" --json-status --unknown
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(JSON event GET "${err}" event)
string(JSON code GET "${err}" exit_code)
if(NOT result EQUAL 2 OR NOT out STREQUAL "" OR NOT event STREQUAL "failed" OR NOT code EQUAL 2)
    message(FATAL_ERROR "Invalid JSON failure protocol: ${out} ${err}")
endif()

