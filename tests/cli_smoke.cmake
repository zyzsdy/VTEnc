function(check_cli expected_status expected_output expected_error)
    execute_process(COMMAND "${VTENC}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${ARGN}: expected ${expected_status}, got ${status}: ${error}")
    endif()
    if(NOT output MATCHES "${expected_output}" OR NOT error MATCHES "${expected_error}")
        message(FATAL_ERROR "${ARGN}: unexpected stdout=[${output}], stderr=[${error}]")
    endif()
endfunction()

